# ── Core ─────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://fabiano:fabiano@localhost:5432/fabiano?schema=public
# 32+ случайных байт: openssl rand -base64 48
SESSION_SECRET=
CART_COOKIE_SECRET=

# ── Storage (S3-compatible; локально — MinIO из docker-compose) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fabiano-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=http://localhost:9000/fabiano-media

# ── Email (восстановление пароля, подтверждение заказа, newsletter double opt-in) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="FABIANO <no-reply@fabiano.uz>"

# ── Payme (метод отключён, пока поля пусты) ──
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=true

# ── Click (метод отключён, пока поля пусты) ──
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

# ── Живая примерка: Decart Lucy V-TON (ключ с platform.decart.ai) ──
DECART_API_KEY=
TRY_ON_CLIENT_SECRET=

# ── Rate limiting (production: Redis) ──
REDIS_URL=

# ── Analytics (публичные, не секреты) ──
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Seed: первый администратор (только для `npm run db:seed`) ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
