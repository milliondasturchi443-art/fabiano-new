{
  "name": "fabiano-store",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "npm run test:unit",
    "test:db": "psql \"$DATABASE_URL\" -f tests/db/inventory.test.sql",
    "test:e2e": "playwright test",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "db:push": "prisma db push --skip-generate",
    "db:constraints": "prisma db execute --file prisma/sql/001_constraints.sql --schema prisma/schema.prisma",
    "db:setup": "prisma generate && npm run db:push && npm run db:constraints && npm run db:seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@tanstack/react-query": "^5.60.0",
    "clsx": "^2.1.0",
    "next": "^15.0.0",
    "next-intl": "^3.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.13.0",
    "server-only": "^0.0.1",
    "sharp": "^0.33.0",
    "zod": "^3.23.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@decartai/sdk": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
